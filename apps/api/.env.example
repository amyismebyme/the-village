## All the different config that is supposed to be part of the project ,not secrets and stuff 
PORT=8080
ENVIRONMENT=development



LOG_LEVEL=info
#supports text or json for the LOG_FORMAT
LOG_FORMAT=json


READ_TIMEOUT=10
REQUEST_TIMEOUT=35
WRITE_TIMEOUT=40
IDLE_TIMEOUT=60
SHUTDOWN_TIMEOUT=15


DB_HOST=localhost
DB_PORT=5432

DB_USER=village
DB_PASSWORD=village
DB_NAME=village
DB_SSLMODE=disable
DB_QUERY_TIMEOUT=30

# External integrations
EXTERNAL_REQUEST_TIMEOUT=15

# Reddit integration
# Disabled by default. Credentials are only required when enabled.
REDDIT_ENABLED=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=the-village/dev
REDDIT_BASE_URL=https://oauth.reddit.com
REDDIT_AUTH_BASE_URL=https://www.reddit.com

# Reddit outbound request pacing.
# Minimum interval between Reddit request starts, in seconds.
REDDIT_REQUEST_INTERVAL=1

# External retry policy
EXTERNAL_RETRY_MAX_ATTEMPTS=3
EXTERNAL_RETRY_INITIAL_BACKOFF=1
EXTERNAL_RETRY_MAX_BACKOFF=30
EXTERNAL_RETRY_BACKOFF_MULTIPLIER=2
EXTERNAL_RETRY_JITTER=0.20

# Background workers
WORKER_ENABLED=false

# Reddit ingestion worker
REDDIT_INGEST_SUBREDDIT=toronto
REDDIT_INGEST_LIMIT=25
REDDIT_INGEST_INTERVAL=300