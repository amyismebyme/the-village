## All the different config that is supposed to be part of the project ,not secrets and stuff 
PORT=8080
ENVIRONMENT=development



LOG_LEVEL=info
#supports text or json for the LOG_FORMAT
LOG_FORMAT=json


READ_TIMEOUT=10
REQUEST_TIMEOUT=35
WRITE_TIMEOUT=40
IDLE_TIMEOUT=60
SHUTDOWN_TIMEOUT=15


DB_HOST=localhost
DB_PORT=5432

DB_USER=village
DB_PASSWORD=village
DB_NAME=village
DB_SSLMODE=disable
DB_QUERY_TIMEOUT=30

# External integrations
EXTERNAL_REQUEST_TIMEOUT=15

