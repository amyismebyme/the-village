# -------------------------------------------------------------------
# Go (Golang) Rules
# -------------------------------------------------------------------
# Compiled binaries/executables
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
*.coverprofile
coverage.txt

# Dependency directories (Only uncomment if you vendoring dependencies)
# vendor/

# Go workspace file
go.work
go.work.sum

