    {
      "id": 5,
      "title": "API pod CPU",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-k8s"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-k8s"
          },
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"village\",pod=~\"village-api.*\",container!=\"POD\",container!=\"\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{pod}}"
        }
      ]
    },
